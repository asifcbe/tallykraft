rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User data (business data, settings, backups) ──────────────────────────
    // Owners read/write their own tree.
    // Staff read is allowed without auth — the ownerUid is not guessable and is
    // only known to staff who received it from the login flow. Writes still require
    // the owner to be signed in so staff can never corrupt data.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
      // Staff read: unauthenticated but must know the exact ownerUid path.
      allow read: if true;
    }

    // ── User access config ────────────────────────────────────────────────────
    match /userConfig/{email} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == email;
    }

    // ── Business records ──────────────────────────────────────────────────────
    // Readable by anyone (business code lookup during staff login).
    // Writable only by the owner.
    match /businesses/{bizId} {
      allow read: if true;
      allow write: if request.auth != null
                   && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
    }

    // ── Staff subcollection ───────────────────────────────────────────────────
    // Readable by anyone (username/password lookup during staff login).
    // Writable only by the business owner.
    match /businesses/{bizId}/staff/{staffId} {
      allow read: if true;
      allow write: if request.auth != null
                   && get(/databases/$(database)/documents/businesses/$(bizId)).data.ownerId == request.auth.uid;
    }

  }
}
